# Public defaults only. The CLI does not load .env files; export reviewed values in your shell.
# Never put private keys here: the CLI never signs. Use a Safe batch (--safe-json) or the printed
# `cast send` commands with --ledger / --account.

# Read/simulate endpoint for CLI commands.
RPC_URL=https://bsc-dataseed.bnbchain.org

# Archive-capable endpoint for the fork tests (pinned historical blocks).
FORK_RPC_URL=https://bsc-mainnet.public.blastapi.io
# Optional fork-test inputs; without them scripts/fork-test.ts pins head-20 and discovers miners.
# DISCOVERY_RPC_URL=https://bsc-dataseed.bnbchain.org
# FORK_BLOCK=128713128
# FORK_NAND_MINER=12733
# FORK_LATCH_MINER=13948
# FORK_INACTIVE_TOKEN=648
# FORK_SCALE_MINERS=4183,1574,6940,4307,4655,3207,13617,7924,11127,4951,3932,10031,14559,16112,8714,2161,6767,11214,6453,14011,16944,15731,7541,5930
# FORK_SCALE_COUNT=24        # miners to discover for the gas-scaling test when FORK_SCALE_MINERS is unset
# FORK_EXTRA_MINERS=4183,1574 # fork-e2e: the two miners admitted as a batch after renunciation
# FORK_CUPS=40               # archive RPC compute units per second (rate limiting)

# Optional Foundry deployment script inputs (script/DeployPool.s.sol).
# SYSTEM_CONFIG=deployments/system.json
# NAND_RECEIPT=0x...
# LATCH_RECEIPT=0x...

# RECOVERABLE CANARY ONLY: scripts/canary/*.ts explicitly load this project's .env.
# Existing CLI commands above remain plan/local tools. Do not share real secret values.
OWNER_PRIVATE_KEY=
BSC_RPC_URL=
EXPECTED_CHAIN_ID=56
MODE=fork
ALLOW_MAINNET_BROADCAST=false
APPROVED_RUN_ID=
# Obtain the measured, concrete bounded proposal with canary:prepare, then approve it in chat.
MAX_RUN_FEE_BNB=
MAX_TX_FEE_BNB=
RECOVERY_RESERVE_BNB=
MAX_WAIT_SECONDS=300
ACCRUAL_INTERVAL_SECONDS=60
MIN_CONFIRMATIONS=3
